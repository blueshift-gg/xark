{
  "name": "@blueshift-gg/xark-wasm",
  "version": "0.0.1",
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/wasm-smoke.test.cjs"
  },
  "types": "./pkg-web/xark_wasm.d.ts",
  "files": [
    "pkg-node/*",
    "pkg-web/*",
    "pkg-bundler/*",
    "pkg-module/*"
  ],
  "exports": {
    ".": {
      "node": {
        "types": "./pkg-node/xark_wasm.d.ts",
        "default": "./pkg-node/xark_wasm.js"
      },
      "workerd": {
        "types": "./pkg-module/xark_wasm.d.ts",
        "default": "./pkg-module/xark_wasm.js"
      },
      "browser": {
        "types": "./pkg-web/xark_wasm.d.ts",
        "default": "./pkg-web/xark_wasm.js"
      },
      "default": {
        "types": "./pkg-web/xark_wasm.d.ts",
        "default": "./pkg-web/xark_wasm.js"
      }
    }
  }
}
