{"noir_version":"1.0.0-beta.22+c57152f91260ecdb9faad4efc20abb14b6d2ece7","hash":"2859562440402464298","abi":{"parameters":[{"name":"msg","type":{"kind":"array","length":3,"type":{"kind":"integer","sign":"unsigned","width":8}},"visibility":"private"},{"name":"digest","type":{"kind":"array","length":32,"type":{"kind":"integer","sign":"unsigned","width":8}},"visibility":"public"}],"return_type":null,"error_types":{}},"bytecode":"","debug_symbols":"","file_map":{"51":{"source":"// Blake2s digest of a 3-byte message. Exercises Noir's\n// `BlackBoxFuncCall::Blake2s` opcode end-to-end (ROADMAP step WS-D.2).\n//\n// Input `msg` is private; the expected `digest` is public and asserted\n// byte-by-byte against the in-circuit hash output.\nuse std::hash::blake2s;\n\nfn main(msg: [u8; 3], digest: pub [u8; 32]) {\n    let h = blake2s(msg);\n    for i in 0..32 {\n        assert(h[i] == digest[i]);\n    }\n}\n","path":"/Users/elon/dev/blueshift/xark/crates/tests/circuits/blake2s_basic/src/main.nr","function_locations":[{"start":324,"name":"main"}]}}}