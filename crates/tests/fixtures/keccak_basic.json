{"noir_version":"1.0.0-beta.21+89a0f0faf3a5f1273c8ac4843b7877882437e277","hash":"7633063214473139357","abi":{"parameters":[{"name":"input","type":{"kind":"array","length":25,"type":{"kind":"integer","sign":"unsigned","width":64}},"visibility":"private"},{"name":"output","type":{"kind":"array","length":25,"type":{"kind":"integer","sign":"unsigned","width":64}},"visibility":"public"}],"return_type":null,"error_types":{}},"bytecode":"","debug_symbols":"","file_map":{"49":{"source":"// Keccak-f[1600] permutation. Exercises Noir's `BlackBoxFuncCall::Keccakf1600`\n// opcode (ROADMAP step WS-D.1).\n//\n// Input is a private 25-lane state; output is the same state after one\n// invocation of the Keccak-f[1600] permutation. The expected output is\n// supplied as a public input and asserted lane-by-lane.\nfn main(input: [u64; 25], output: pub [u64; 25]) {\n    let res = std::hash::keccakf1600(input);\n    for i in 0..25 {\n        assert(res[i] == output[i]);\n    }\n}\n","path":"/Users/elon/dev/blueshift/xark/examples/keccak_basic/src/main.nr","function_locations":[{"start":366,"name":"main"}]}}}