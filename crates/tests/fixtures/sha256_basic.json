{"noir_version":"1.0.0-beta.22+c57152f91260ecdb9faad4efc20abb14b6d2ece7","hash":"5721641342871702330","abi":{"parameters":[{"name":"block","type":{"kind":"array","length":16,"type":{"kind":"integer","sign":"unsigned","width":32}},"visibility":"private"},{"name":"state","type":{"kind":"array","length":8,"type":{"kind":"integer","sign":"unsigned","width":32}},"visibility":"private"},{"name":"state_out","type":{"kind":"array","length":8,"type":{"kind":"integer","sign":"unsigned","width":32}},"visibility":"public"}],"return_type":null,"error_types":{}},"bytecode":"","debug_symbols":"nZHBCoMwDED/Jece3Fqn81fGkKpRCqVKbQdD/PdFq04Pg+HpNUlfE5oBKix8kytTtz1kjwEKq7RWTa7bUjrVGsoOI4M1zJ1FpBTs6mR10qJxkBmvNYOX1H6+1HfSzHTSUjVigKYi0oO10jidRva1o98qT+JFFlGy6fHlX18IsfoknfDjrf/tVH+ebH568J8UyVLZw48Dv0J2YcA5CQQREAfcApKANOA+Q0SEcZrDKlloXNZXe1Putune3VpZ993ZtsTKW5zmmGs02Qc=","file_map":{"51":{"source":"use std::hash::sha256_compression;\n\n// Run one SHA-256 compression on a single padded block.\n//\n// `state_out` is the 8-word post-compression state. With `state` set to the\n// SHA-256 IV and `block` set to the padded \"abc\" message block, this should\n// equal SHA-256(\"abc\").\nfn main(\n    block: [u32; 16],\n    state: [u32; 8],\n    state_out: pub [u32; 8],\n) {\n    let next = sha256_compression(block, state);\n    for i in 0..8 {\n        assert(next[i] == state_out[i]);\n    }\n}\n","path":"/Users/elon/dev/blueshift/xark/crates/tests/circuits/sha256_basic/src/main.nr","function_locations":[{"start":358,"name":"main"}]}}}