{"noir_version":"1.0.0-beta.21+89a0f0faf3a5f1273c8ac4843b7877882437e277","hash":"218083768188065228","abi":{"parameters":[{"name":"block","type":{"kind":"array","length":16,"type":{"kind":"integer","sign":"unsigned","width":32}},"visibility":"private"},{"name":"state","type":{"kind":"array","length":8,"type":{"kind":"integer","sign":"unsigned","width":32}},"visibility":"private"},{"name":"state_out","type":{"kind":"array","length":8,"type":{"kind":"integer","sign":"unsigned","width":32}},"visibility":"public"}],"return_type":null,"error_types":{}},"bytecode":"","debug_symbols":"nZHBCoMwDED/Jece3Frn9FfGkKpRCqVKbQdD/PdFq04Pg+HptUleE5oBKix8kytTtz1kjwEKq7RWTa7bUjrVGooOI4P1mjuLSCHY5cnqpEXjIDNeawYvqf1c1HfSzHTSUjZigKYi0oO10jidRva1o98qT+JFFlGy6SL91xdCrH58OePHW//bqf482fz7wX/STZbKHn4c+BWyCwPOqYggAuKAW0AScA9IZ4iIME5zWCULjcv6am/K3Tbdu1sz674725ZYeYvTHHOOJvsA","file_map":{"49":{"source":"use std::hash::sha256_compression;\n\n// Run one SHA-256 compression on a single padded block.\n//\n// `state_out` is the 8-word post-compression state. With `state` set to the\n// SHA-256 IV and `block` set to the padded \"abc\" message block, this should\n// equal SHA-256(\"abc\").\nfn main(\n    block: [u32; 16],\n    state: [u32; 8],\n    state_out: pub [u32; 8],\n) {\n    let next = sha256_compression(block, state);\n    for i in 0..8 {\n        assert(next[i] == state_out[i]);\n    }\n}\n","path":"/Users/elon/dev/blueshift/xark/examples/sha256_basic/src/main.nr","function_locations":[{"start":358,"name":"main"}]}}}