theorem slopes_length : slopes.length = 254 := by decide +kernel

theorem chain128 :
    chainOk ((slopes.take 128).map (↑)) (oX, oY) = true ∧
      chain ((slopes.take 128).map (↑)) (oX, oY) = (corrX, -corrY) := by
  decide +kernel

theorem chain254 :
    chainOk (slopes.map (↑)) (oX, oY) = true ∧ chain (slopes.map (↑)) (oX, oY) = (corr254X, -corr254Y) := by
  decide +kernel

theorem neg_eq {x y : F} (h : grumpkinCurve.Nonsingular x y) (h' : grumpkinCurve.Nonsingular x (-y)) :
    -(Point.some _ _ h' : GrumpkinPoint) = Point.some _ _ h := by
  rw [Point.neg_some, Point.some.injEq]
  simp [negY, grumpkinCurve]

/-- `corr = −(2¹²⁸·O)`. -/
theorem corr_eq : (Point.some _ _ corrNs : GrumpkinPoint) = -((2 ^ 128) • O) := by
  obtain ⟨h₁, h₂⟩ := chain128
  obtain ⟨h', hc⟩ := chain_sound _ _ _ oNs h₁
  have hl : ((slopes.take 128).map (↑) : List F).length = 128 := by
    rw [List.length_map, List.length_take, slopes_length]; rfl
  simp only [h₂, hl] at h' hc
  rw [O, ← hc, neg_eq corrNs h']

/-- `corr254 = −(2²⁵⁴·O)`. -/
theorem corr254_eq : (Point.some _ _ corr254Ns : GrumpkinPoint) = -((2 ^ 254) • O) := by
  obtain ⟨h₁, h₂⟩ := chain254
  obtain ⟨h', hc⟩ := chain_sound _ _ _ oNs h₁
  have hl : (slopes.map (↑) : List F).length = 254 := by rw [List.length_map, slopes_length]
  simp only [h₂, hl] at h' hc
  rw [O, ← hc, neg_eq corr254Ns h']

/-! ### The signed-digit accumulator -/

/-- Bit `k` of a word of bits `b` is `b k`. -/
theorem word_div_mod (b : ℕ → ℕ) (n : ℕ) (hb : ∀ i < n, b i ≤ 1) (k : ℕ) (hk : k < n) :
    (∑ i ∈ Finset.range n, 2 ^ i * b i) / 2 ^ k % 2 = b k := by
  have h := Xark.Templates.Add32.testBit_word b n hb k hk
  rw [Nat.testBit_eq_decide_div_mod_eq, decide_eq_true_iff] at h
  have := hb k hk
  by_cases h1 : b k = 1
  · rw [h1]; exact h.mpr h1
  · have : (∑ i ∈ Finset.range n, 2 ^ i * b i) / 2 ^ k % 2 ≠ 1 := fun e => h1 (h.mp e)
    omega

/-- The signed-digit accumulator from `O`, with addend `P` at step `0` and `±P` for bit
`n − j` at step `j ≥ 1`, holds `2ʲ·O + (2·⌊s / 2^(n+1−j)⌋ + 1)·P` after step `j`, `s` the
word of the bits. -/
theorem accum_digits {G : Type*} [AddCommGroup G] (O P : G) (n : ℕ) (b : ℕ → ℕ)
    (hb : ∀ i < n, b i ≤ 1) (s : ℕ) (hs : s = ∑ i ∈ Finset.range n, 2 ^ i * b i)
    (S : ℕ → G) (hS0 : S 0 = P)
    (hS : ∀ j, 1 ≤ j → j < n → S j = if b (n - j) = 1 then P else -P) :
    ∀ j, 1 ≤ j → j ≤ n → DoubleAdd.accum O S j =
      (2 ^ j) • O + (2 * (s / 2 ^ (n + 1 - j)) + 1) • P := by
  intro j hj1 hjn
  induction j, hj1 using Nat.le_induction with
  | base =>
    have h0 : s / 2 ^ n = 0 := Nat.div_eq_of_lt (hs ▸ Xark.Templates.Add32.word_lt b n hb)
    simp only [DoubleAdd.accum, hS0, Nat.add_sub_cancel, h0]
    module
  | succ j hj1 ih =>
    rw [DoubleAdd.accum, ih (by omega), hS j hj1 (by omega)]
    have hw := word_div_mod b n hb (n - j) (by omega)
    rw [← hs] at hw
    have h1 : s / 2 ^ (n + 1 - j) = s / 2 ^ (n - j) / 2 := by
      rw [show n + 1 - j = n - j + 1 by omega, pow_succ, Nat.div_div_eq_div_mul]
    have hq : s / 2 ^ (n + 1 - (j + 1)) = 2 * (s / 2 ^ (n + 1 - j)) + b (n - j) := by
      rw [show n + 1 - (j + 1) = n - j by omega, h1, ← hw]
      omega
    rw [hq]
    have := hb (n - j) (by omega)
    generalize s / 2 ^ (n + 1 - j) = q
    split_ifs with h
    · rw [h, pow_succ]; module
    · rw [show b (n - j) = 0 by omega, pow_succ]; module

/-- The last add removes the offset and the `+1`: `acc_n + q = s·P` for
`q = corr` (bit 0 set) or `corr − P`, `corr = −2ⁿ·O`. -/
theorem final_eq {G : Type*} [AddCommGroup G] (O P C : G) (n s : ℕ) (hC : C = -((2 ^ n) • O)) :
    (2 ^ n) • O + (2 * (s / 2) + 1) • P + (if s % 2 = 1 then C else C + -P) = s • P := by
  have hs := Nat.div_add_mod s 2
  generalize s / 2 = q at hs ⊢
  have h2 := Nat.mod_lt s (show 2 > 0 by omega)
  generalize s % 2 = m at hs h2 ⊢
  subst hs hC
  interval_cases m
  · rw [if_neg zero_ne_one]; module
  · rw [if_pos rfl]; module

end Xark.GrumpkinMul
