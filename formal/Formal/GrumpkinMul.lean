/-!
# Grumpkin facts for `xark_grumpkin`'s scalar multiplications

* `short`: Grumpkin `y² = x³ − 17` over BN254's scalar field is a `DoubleAdd.Short` curve.
  Its one nontrivial field is "no 2-torsion": `17` is not a cube mod `r`, because
  `17^((r−1)/3) ≠ 1` (computed by the kernel with `Pratt.powMod`).
  (`Xark.Grumpkin` in `Formal/GrumpkinOrder.lean` has `two_ne` and `nonsingular_iff`.)
* The offset `O = (5, …)` and the corrections the gadgets add at the end:
  `corr_eq : corr = −(2¹²⁸·O)` and `corr254_eq : corr254 = −(2²⁵⁴·O)`. A chain of 254
  tangent slopes, each checked by the kernel against `λ·2y = 3x²`, certifies `2ⁱ·O`.

No group-order fact is used: the gadgets' incomplete adds are guarded in-circuit.
-/

namespace Xark.GrumpkinMul

open WeierstrassCurve WeierstrassCurve.Affine Xark.DoubleAdd Xark.Grumpkin

/-- BN254's scalar field, Grumpkin's base field. -/
local notation "F" => ZMod r

/-- `17` is not a cube mod `r`: `17^((r−1)/3) ≠ 1`. -/
theorem not_cube (x : F) : x ^ 3 ≠ 17 := by
  intro h
  have hx : x ≠ 0 := by
    rintro rfl
    have : (0 : F) = 17 := by simpa using h
    exact absurd this (by decide +kernel)
  have h1 := ZMod.pow_card_sub_one_eq_one hx
  have hr : r - 1 = 3 * ((r - 1) / 3) := by unfold r; norm_num
  rw [hr, pow_mul, h] at h1
  have hp := Pratt.powMod_cast 17 ((r - 1) / 3) r (by unfold r; norm_num)
  have : (Pratt.powMod 17 ((r - 1) / 3) r : F) ≠ 1 := by decide +kernel
  exact this (by rw [hp]; exact_mod_cast h1)

theorem short : Short grumpkinCurve where
  a₁ := rfl
  a₂ := rfl
  a₃ := rfl
  two := Grumpkin.two_ne
  noTwoTorsion x h := by
    rw [equation_iff] at h
    simp only [grumpkinCurve] at h
    exact not_cube x (by linear_combination -h)

/-! ### The offset and its corrections -/

/-- The offset `O = (5, y_O)` (`xark_grumpkin::offset`). -/
def oX : F := 5
def oY : F := 26447525821777463057023244913909144251512587297343525263882

theorem oNs : grumpkinCurve.Nonsingular oX oY := nonsingular_iff.mpr (by decide +kernel)

/-- `O`. -/
noncomputable def O : GrumpkinPoint := Point.some _ _ oNs

/-- `corr = −(2¹²⁸·O)` (`xark_grumpkin::corr`). -/
def corrX : F := 15091588220200540439587434062098309947749547413125795808386331904279218024383
def corrY : F := 9700730252355689723080387012214398702149611734773390356605491655538683087420

/-- `corr254 = −(2²⁵⁴·O)` (`xark_grumpkin::corr254`). -/
def corr254X : F := 16553197835714973834031774601520451931051624293930580121206769559624452310037
def corr254Y : F := 19649441642928946798700829372424834756358685055060237751050452085768514233992

theorem corrNs : grumpkinCurve.Nonsingular corrX corrY := nonsingular_iff.mpr (by decide +kernel)
theorem corr254Ns : grumpkinCurve.Nonsingular corr254X corr254Y :=
  nonsingular_iff.mpr (by decide +kernel)

/-- The tangent rule at slope `l`: `(x, y) ↦ (l² − 2x, l(x − x') − y)`. -/
def tangent (l : F) (p : F × F) : F × F :=
  (l ^ 2 - 2 * p.1, l * (p.1 - (l ^ 2 - 2 * p.1)) - p.2)

/-- The point after the tangent steps `ls`. -/
def chain : List F → F × F → F × F
  | [], p => p
  | l :: ls, p => chain ls (tangent l p)

/-- Each slope of `ls` is the tangent's at the point it starts from, which has `y ≠ 0`. -/
def chainOk : List F → F × F → Bool
  | [], _ => true
  | l :: ls, p => (l * (2 * p.2) == 3 * p.1 ^ 2 && p.2 != 0) && chainOk ls (tangent l p)

/-- A checked chain of `n` tangent steps from `P` ends at `2ⁿ·P`. -/
theorem chain_sound : ∀ (ls : List F) (x y : F) (h : grumpkinCurve.Nonsingular x y),
    chainOk ls (x, y) = true →
      ∃ h' : grumpkinCurve.Nonsingular (chain ls (x, y)).1 (chain ls (x, y)).2,
        Point.some _ _ h' = (2 ^ ls.length) • Point.some _ _ h
  | [], x, y, h, _ => ⟨h, by simp [chain]⟩
  | l :: ls, x, y, h, hok => by
    simp only [chainOk, Bool.and_eq_true, beq_iff_eq, bne_iff_ne, ne_eq] at hok
    obtain ⟨⟨hl, hy⟩, hok⟩ := hok
    obtain ⟨h₁, hd⟩ := double_of_slope short h hy (by rw [hl]; simp [grumpkinCurve]) rfl rfl
    obtain ⟨h', hc⟩ := chain_sound ls _ _ h₁ hok
    refine ⟨h', ?_⟩
    rw [List.length_cons, pow_succ', mul_nsmul, two_nsmul, hd]
    exact hc

