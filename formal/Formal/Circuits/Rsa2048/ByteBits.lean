theorem chainN_packing (σ : ℕ → F) (h : Sat circuit σ) :
    chainN σ = ∑ j ∈ Finset.range 2048, nBits σ j * 2 ^ j := by
  rw [chainN_limb σ h]
  rw [show (∑ q ∈ Finset.range 25, Xark.Rsa.Bytes.limbOf (nBits σ) 82 2048 q * W ^ q)
      = ∑ q ∈ Finset.range 25, Xark.Rsa.Bytes.limb (nBits σ) q * 2 ^ (82 * q) from by
    refine Finset.sum_congr rfl fun q hq => ?_
    rw [Xark.Rsa.Bytes.limb, W, pow_mul]]
  exact Xark.Rsa.Bytes.packing (nBits σ)

theorem chainSig_packing (σ : ℕ → F) (h : Sat circuit σ) :
    val (limb sq0 σ 0) = ∑ j ∈ Finset.range 2048, sigBits σ j * 2 ^ j := by
  rw [chainSig_limb σ h]
  rw [show (∑ q ∈ Finset.range 25, Xark.Rsa.Bytes.limbOf (sigBits σ) 82 2048 q * W ^ q)
      = ∑ q ∈ Finset.range 25, Xark.Rsa.Bytes.limb (sigBits σ) q * 2 ^ (82 * q) from by
    refine Finset.sum_congr rfl fun q hq => ?_
    rw [Xark.Rsa.Bytes.limb, W, pow_mul]]
  exact Xark.Rsa.Bytes.packing (sigBits σ)

theorem chainN_eq_bytes (σ : ℕ → F) (h : Sat circuit σ) :
    chainN σ = ∑ i ∈ Finset.range 256, ((σ i).val : ℤ) * 256 ^ (255 - i) := by
  rw [chainN_packing σ h]
  exact (Xark.Rsa.Bytes.bytes_of_bits (nBits σ) (fun i => ((σ i).val : ℤ)) (nBits_eq σ h)).symm

theorem chainSig_eq_bytes (σ : ℕ → F) (h : Sat circuit σ) :
    val (limb sq0 σ 0) = ∑ i ∈ Finset.range 256, ((σ (256 + i)).val : ℤ) * 256 ^ (255 - i) := by
  rw [chainSig_packing σ h]
  exact (Xark.Rsa.Bytes.bytes_of_bits (sigBits σ) (fun i => ((σ (256 + i)).val : ℤ))
    (sigBits_eq σ h)).symm

