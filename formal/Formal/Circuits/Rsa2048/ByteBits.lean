import Formal.Circuits.Rsa2048.ChainBits

set_option linter.style.header false
set_option maxRecDepth 100000
set_option maxHeartbeats 0

/-!
# The modulus and signature byte strings

`to_bits` decomposes each public byte, and `bytes_to_wide` places the bits
big-endian. This file proves each of the 512 public bytes is the sum of its placed
bits (`nbyte_i`, `sbyte_i`), then that the chain's `n` and `sig` limb vectors are
the big-endian integers of those bytes.
-/

namespace Xark.Circuits.Rsa2048

open Xark.Circuit Xark.R1cs Xark.Template
open Xark.Rsa.GroupedColumns (val W)

theorem nbyte_0 (σ : ℕ → F) (h : Sat circuit σ) :
    ((σ 0).val : ℤ) = ∑ t ∈ Finset.range 8, nBits σ (8 * (255 - 0) + t) * 2 ^ t := by
  have hs : (callAt 0).t.Sat ((callAt 0).lift σ) :=
    call_sat_of h 0 (callAt 0) (by rfl) (by decide)
  have hb0 : (callAt 0).t = Xark.Templates.ToBits.template := by rfl
  rw [hb0] at hs
  have hspec := Xark.Templates.ToBits.soundness ((callAt 0).lift σ) hs
  rw [Xark.Templates.ToBits.Spec, Xark.Templates.ToBits.SpecAt] at hspec
  have hplugs : (callAt 0).plugs = [(Xark.R1cs.LC.var (0 : ℕ) : Xark.Circuit.ZLC)] := by rfl
  have hbase : (callAt 0).base = bitBase 0 := by rfl
  have hins : ((Xark.Templates.ToBits.template.ins ((callAt 0).lift σ)).getD 0 0) = σ 0 := by
    simp [Xark.Template.Template.ins, Xark.Templates.ToBits.template, Call.lift, Call.env, hplugs,
      ZLC.toF, LC.eval, LC.var, LC.cst, zero_add, one_mul]
  have hlt : (σ 0).val < 2 ^ 8 := by
    rw [hins] at hspec
    exact hspec.1
  have hbit : ∀ t < 8, (bitGLC 0 t).eval σ
      = (Xark.Templates.ToBits.template.outs ((callAt 0).lift σ)).getD t 0 := by
    intro t ht
    rw [bitGLC_eq_bitOut 0 t ht hplugs hbase hb0, bitOut_eval, hb0]
  have hspec_t : ∀ t < 8, (Xark.Templates.ToBits.template.outs ((callAt 0).lift σ)).getD t 0
      = Xark.Template.bitOf ((Xark.Templates.ToBits.template.ins ((callAt 0).lift σ)).getD 0 0) t := by
    intro t ht
    have := congrArg (fun l => l.getD t 0) hspec.2
    simpa [List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_range ht] using this
  have hword := Xark.Templates.Add32.word_testBit (σ 0).val 8 hlt
  rw [← hword, Nat.cast_sum]
  refine Finset.sum_congr rfl fun t ht => ?_
  have ht8 := Finset.mem_range.mp ht
  have hnb : nBits σ (8 * (255 - 0) + t) = (Xark.Template.bitOf (σ 0) t).val := by
    unfold nBits
    have h1 : (8 * (255 - 0) + t) / 8 = 255 - 0 := by omega
    have h2 : (8 * (255 - 0) + t) % 8 = t := by omega
    rw [h1, h2, hbit t ht8, hspec_t t ht8, hins]
  rw [hnb]
  have hbitval : (Xark.Template.bitOf (σ 0) t).val = (if (σ 0).val.testBit t then 1 else 0) := by
    by_cases htc : (σ 0).val.testBit t
    · simp [Xark.Template.bitOf, htc, ZMod.val_one]
    · simp [Xark.Template.bitOf, htc, ZMod.val_zero]
  rw [hbitval]
  push_cast
  ring

