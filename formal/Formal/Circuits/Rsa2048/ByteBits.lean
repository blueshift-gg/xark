    rw [h1, h2, hbit t ht8, hspec_t t ht8, hins]
  rw [hnb]
  have hbitval : (Xark.Template.bitOf (σ 511) t).val = (if (σ 511).val.testBit t then 1 else 0) := by
    by_cases htc : (σ 511).val.testBit t
    · simp [Xark.Template.bitOf, htc, ZMod.val_one]
    · simp [Xark.Template.bitOf, htc, ZMod.val_zero]
  rw [hbitval]
  push_cast
  ring

