{
  "name": "xark-client",
  "version": "0.1.0",
  "description": "Verify xark zero-knowledge proofs with snarkjs and build Solana instruction data, driven by a circuit IDL.",
  "license": "MIT",
  "repository": "https://github.com/blueshift-gg/xark",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "tsx test/smoke.ts",
    "typecheck": "tsc --noEmit"
  },
