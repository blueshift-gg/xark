{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types", "./node_modules"],
    "types": ["node", "vitest/globals"]
  },
  "include": ["*.ts", "*/*.ts"]
}
