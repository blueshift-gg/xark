digraph R1CS {
  rankdir=LR;

  v0 [label="x\nPrivate"];
  v1 [label="bit0\nPublic"];
  v2 [label="bit7\nPublic"];
  v3 [label="w0\nPrivate"];
  v4 [label="w1\nPrivate"];
  v5 [label="w2\nPrivate"];
  v6 [label="w3\nPrivate"];
  v7 [label="w4\nPrivate"];
  v8 [label="w5\nPrivate"];
  v9 [label="w6\nPrivate"];

  constraint0 [shape=box, label="C0: w0 in {0,1}"];
  constraint1 [shape=box, label="C1: w1 in {0,1}"];
  constraint2 [shape=box, label="C2: w2 in {0,1}"];
  constraint3 [shape=box, label="C3: w3 in {0,1}"];
  constraint4 [shape=box, label="C4: w4 in {0,1}"];
  constraint5 [shape=box, label="C5: w5 in {0,1}"];
  constraint6 [shape=box, label="C6: w6 in {0,1}"];
  constraint7 [shape=box, label="C7: 8-bit range: bit 0 = value − Σ 2ⁱ·bᵢ ∈ {0,1}"];
  constraint8 [shape=box, label="C8: (x - bit0 - 2*w0 - 4*w1 - 8*w2 - 16*w3 - 32*w4 - 64*w5 - 128*w6) * 1 = 0"];
  constraint9 [shape=box, label="C9: (-bit7 + w6) * 1 = 0"];

  v3 -> constraint0;
  constraint0 -> v3;
  v4 -> constraint1;
  constraint1 -> v4;
  v5 -> constraint2;
  constraint2 -> v5;
  v6 -> constraint3;
  constraint3 -> v6;
  v7 -> constraint4;
  constraint4 -> v7;
  v8 -> constraint5;
  constraint5 -> v8;
  v9 -> constraint6;
  constraint6 -> v9;
  v0 -> constraint7;
  v3 -> constraint7;
  v4 -> constraint7;
  v5 -> constraint7;
  v6 -> constraint7;
  v7 -> constraint7;
  v8 -> constraint7;
  v9 -> constraint7;
  v0 -> constraint8;
  v1 -> constraint8;
  v3 -> constraint8;
  v4 -> constraint8;
  v5 -> constraint8;
  v6 -> constraint8;
  v7 -> constraint8;
  v8 -> constraint8;
  v9 -> constraint8;
  v2 -> constraint9;
  v9 -> constraint9;
}
