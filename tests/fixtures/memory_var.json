{"noir_version":"1.0.0-beta.21+89a0f0faf3a5f1273c8ac4843b7877882437e277","hash":"12096577937335857107","abi":{"parameters":[{"name":"arr","type":{"kind":"array","length":4,"type":{"kind":"field"}},"visibility":"private"},{"name":"idx","type":{"kind":"field"},"visibility":"private"},{"name":"y","type":{"kind":"field"},"visibility":"public"}],"return_type":null,"error_types":{}},"bytecode":"","debug_symbols":"nZFNDoMgEIXvMmsWKPZHr9I0BnVsSAgaCk0a4907TtXqoknTzXswj48MzAANVvFWGtd2dyguA1TeWGtupe1qHUznqDqMApZtGTwilWCTE9Vrjy5A4aK1Ah7aRj5077VjD9pTKgWga8jpwtZYnFaj+NDyO6oSNcMqVSue5T/z8rDy2R98mp8XXskdf6Wdro3f/RgkUCQCUlbFmrEeWI+sJ9Yza86ayLcRnZIRPr31ob3RlcV5FG109WYy4dkvyTK73nc1NtHj1BNn1OUL","file_map":{"49":{"source":"// Variable-index read. Noir's SSA optimizer keeps the array as memory\n// when the index isn't a compile-time constant.\nfn main(arr: [Field; 4], idx: Field, y: pub Field) {\n    let mut mutable = arr;\n    // Force a write at constant index so the array stays in memory:\n    mutable[0] = arr[0];\n    assert(mutable[idx as u32] == y);\n}\n","path":"/Users/elon/dev/blueshift/xark/examples/memory_var/src/main.nr","function_locations":[{"start":171,"name":"main"}]}}}